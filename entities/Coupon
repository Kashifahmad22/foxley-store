{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Coupon code"
    },
    "description": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "flat"
      ],
      "default": "percentage"
    },
    "discount_value": {
      "type": "number"
    },
    "min_order_value": {
      "type": "number",
      "default": 0
    },
    "max_discount": {
      "type": "number",
      "description": "Max discount cap for percentage coupons"
    },
    "usage_limit": {
      "type": "number"
    },
    "used_count": {
      "type": "number",
      "default": 0
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ]
}